# DAYANERA.ai - LAN reverse proxy (Caddy 2).
#
#   LAN client -> https://dayanera.ai.lan (Caddy :443, :80 redirects to https)
#     /api/*  -> FastAPI  127.0.0.1:8000  (streaming/SSE passthrough)
#     /*      -> UI       127.0.0.1:5173  (vite preview, static build)
#   Ollama (127.0.0.1:11434) and PostgreSQL (127.0.0.1:54329) are NOT proxied.
#
# Run from the repository root (paths below are relative to it):
#   caddy run --config deploy\caddy\Caddyfile --adapter caddyfile
# scripts\start-dayanera-server.ps1 does this.
{
	# Admin API stays on loopback.
	admin 127.0.0.1:2019
	# Certificates and the local CA live under data\ (git-ignored, preserved).
	storage file_system data/caddy
	# .lan is not publicly resolvable: never try public ACME, and install trust explicitly.
	local_certs
	skip_install_trust
}

dayanera.ai.lan {
	tls internal

	# Internal API schema is not needed by LAN clients.
	# (a handle block: handle is ordered before a bare respond directive)
	handle /api/v1/openapi.json {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Deliver chat tokens (text/event-stream) immediately.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:5173 {
			# vite preview only accepts loopback Host headers.
			header_up Host 127.0.0.1:5173
		}
	}

	header Strict-Transport-Security "max-age=31536000"

	log {
		output file data/logs/caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
