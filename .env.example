# =====================================================================
# DAYANERA.ai - local beta configuration template
#
# Copy to ".env" (scripts/bootstrap.ps1 does this for you) and adjust.
# The real ".env" is ignored by Git. Never commit real credentials.
# All services must listen on 127.0.0.1 / localhost only.
# =====================================================================

# --- Application ----------------------------------------------------
APP_NAME=DAYANERA.ai
APP_ENV=beta_local
# Backend bind address. Only 127.0.0.1, localhost or ::1 are accepted.
APP_HOST=127.0.0.1
APP_PORT=8000
# Browser UI (Vite) bind address. Only loopback addresses are accepted.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# --- Local Docker PostgreSQL (authoritative beta database) ----------
POSTGRES_DB=dayanera
POSTGRES_USER=dayanera
# bootstrap.ps1 replaces this placeholder with a random local password.
POSTGRES_PASSWORD=change-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
DATABASE_URL=postgresql+psycopg://dayanera:change-local-password@127.0.0.1:54329/dayanera

# --- Local inference (native Windows Ollama service) ------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default/production model (fits fully in 12 GB VRAM).
OLLAMA_MODEL=qwen3:14b-q4_K_M
# Optional side-by-side models, installed by the home-server installer.
# Not used automatically yet; switch by copying one into OLLAMA_MODEL.
# FAST: official Ollama tag. HEAVY: local name created from
# scripts\models\qwen3.8-27b-q2_K.Modelfile (Q2_K GGUF, experimental, VRAM-tight).
OLLAMA_FAST_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_HEAVY_MODEL=qwen3.8-27b-q2_K
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
# Context window and generation limits (CPU-friendly defaults).
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=700
OLLAMA_KEEP_ALIVE=30m
# Model reasoning ("thinking", e.g. qwen3). Keep false: it consumes OLLAMA_NUM_PREDICT.
OLLAMA_THINK=false

# --- Initial local admin (seeded idempotently on first startup) -------
# Beta-only credentials. Change before any wider use; see README
# "Security hardening" section.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=1234

# --- Paths (all application-controlled data stays under PROJECT_ROOT) -
PROJECT_ROOT=C:\\Users\\Bediz\\Documents\\DAYANERA.ai
ISO_BOOKLETS_PATH=C:\\Users\\Bediz\\Documents\\DAYANERA.ai\\iso booklets
DATA_ROOT=C:\\Users\\Bediz\\Documents\\DAYANERA.ai\\data
AGENT_NOTES_PATH=C:\\Users\\Bediz\\Documents\\DAYANERA.ai\\agent-notes
# Optional extra watched folders (comma separated, must be below PROJECT_ROOT).
EXTRA_WATCH_ROOTS=

# --- Document watcher / ingestion -----------------------------------
WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=30
INGESTION_WORKERS=1
UPLOAD_MAX_BYTES=1073741824
OCR_ENABLED=true
OCR_DPI=200
OCR_MAX_PAGES_PER_DOCUMENT=250
IMAGE_MAX_PIXELS=40000000
ARCHIVE_MAX_MEMBERS=2000
ARCHIVE_MAX_TOTAL_UNCOMPRESSED_BYTES=2147483648
ARCHIVE_MAX_MEMBER_BYTES=536870912
ARCHIVE_MAX_COMPRESSION_RATIO=200
# PDF parser layer (docs/RAG_INGESTION.md): pymupdf (default; text layer + deterministic
# ISO layout, selected by the pilot evaluation) | hybrid (pymupdf + Docling table structure)
# | docling (Docling layout for every block). Docling is optional and runs out of process in
# its own virtual environment (backend/requirements-docling.txt); the backend never imports it.
PDF_PARSER=pymupdf
DOCLING_PYTHON=
# Formula LaTeX from Docling's formula model is model output: stored as draft, needs review.
DOCLING_FORMULA_ENRICHMENT=false
DOCLING_TIMEOUT_SECONDS=3600
# Local speech-to-text (faster-whisper). The model is fetched once by
# scripts/fetch-local-models.ps1 into DATA_ROOT\models and loaded offline.
TRANSCRIPTION_ENABLED=true
WHISPER_MODEL_NAME=small
WHISPER_COMPUTE_TYPE=int8
# Optional read-only override of the model folder (default: DATA_ROOT\models\faster-whisper-<name>)
WHISPER_MODEL_PATH=
AUDIO_MAX_SECONDS=3600
VIDEO_MAX_TRANSCRIBE_SECONDS=600
VIDEO_FRAME_COUNT=3

# --- Retrieval / answer policy ----------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_CONTEXT_CHARS=3000
# Relevance gate (Step 2): refuse before any LLM call when the best passage supports
# less than this share of the question's significant terms (calibrated: 0.4).
RETRIEVAL_MIN_SCORE=0.4
# Share of glossary concepts a passage must match to be a candidate.
RETRIEVAL_MIN_COVERAGE=0.5
SESSION_TTL_HOURS=12
CALC_LLM_COMPARE=true
# Self-maintenance: diagnose Qwen-draft mismatches, verify corrections by deterministic regression.
SELF_MAINTENANCE_ENABLED=true
# VERIFIED knowledge in Qwen calculation drafts: targeted | all | off
KNOWLEDGE_CONTEXT_MODE=targeted
SUMMARY_EVERY_N_MESSAGES=12

# --- Future cloud AI providers (DISABLED in beta; never called) ------
LLM_PROVIDER=local_ollama
OPENAI_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=

# --- Optional two-way PostgreSQL sync (run sync-init before enabling) ---
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct or Session pooler URI from Supabase Connect; includes DB password.
# Server-side only. API keys are not a replacement. Never set in VITE_*.
SUPABASE_DATABASE_URL=
SUPABASE_SYNC_INTERVAL_SECONDS=60

# --- Frontend (read by Vite at build/dev time; no secrets here) -------
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
